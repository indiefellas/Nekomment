---
import { Database } from "../../lib/databaseInterface";
import HostCard from "./HostCard.svelte";

const { user } = Astro.props;
const { env } = Astro.locals.runtime;
const db = new Database(env);

const hosts = await db.getHosts(
    Astro.cookies.get("token")?.value ?? "",
);
if (!hosts.success)
    return Astro.redirect("/login?redirect=" + Astro.url.pathname, 302);

const pages = await db.getPages(
    Astro.cookies.get("token")?.value ?? "",
);
if (!pages.success)
    return Astro.redirect("/login?redirect=" + Astro.url.pathname, 302);
---

<div class="fill-screen">
    <div class="dashboard-container">
        <div class="left">
            <h1 class="sep">Hello, {user.data.name}<i>!</i></h1>
            <div class="hosts-container">
                <div class="heading">
                    <h2>Hosts</h2>
                    <a href="/add-host" class="button primary">Add new</a>
                </div>
                <div class="hosts-list">
                    {
                        hosts.data?.map((h) => (
                            <HostCard 
                                host={h.host}
                                comments={h.comments.length}
                                inReview={h.comments.filter(x=>!x.approved).length}
                                client:load
                            />
                        ))
                    }
                    {hosts.data?.length === 0 && <p>No hosts yet!</p>}
                </div>
            </div>
            <hr />
            <div class="hosts-container">
                <div class="heading">
                    <h2>Pages</h2>
                    <a href="/add-page" class="button primary">Add new</a>
                </div>
                <div class="hosts-list">
                    {
                        pages.data?.map((h) => (
                            <a
                                class="button"
                                href={
                                    "/host/" + h.hostName + "/page/" + h.name
                                }
                            >
                                <h2>{h.displayName}</h2>
                                <p>{h.hostName}</p>
                            </a>
                        ))
                    }
                    {pages.data?.length === 0 && <p>No pages yet!</p>}
                </div>
            </div>
        </div>
        <div class="right">
            <h2>News</h2>
            <div class="card">
                <h3>Work in progress!</h3>
                <p>Please note that Nekomment is still work in progress!</p>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        margin-inline: var(--main-margin);
        margin-top: 12px;
        display: grid;
        grid-template-columns: 0.65fr 0.35fr;
        gap: 25px;
    }

    .left {
        container: left;
    }

    .right {
        border-radius: 5px;
    }

    hr {
        margin-block: 20px;
        border: none;
        border-bottom: 1px solid var(--color-1);
    }

    .hosts-container {
        margin-top: 12px;
        container-type: inline-size;

        .hosts-list {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;

            a {
                text-decoration: none;
                padding: 20px;
            }
        }

        @container (width <= 700px) {
            .hosts-list {
                grid-template-columns: repeat(1, 1fr);
            }
        }
    }

    .right {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    @media screen and (width <= 900px) {
        .dashboard-container {
            grid-template-columns: 1fr;
        }

        .left {
            padding-bottom: 20px;
            border-bottom: 1px solid var(--background-3);
        }
    }

    @media screen and (width <= 640px) {
        h2 {
            font-size: 1.8em;
        }
    }
</style>
