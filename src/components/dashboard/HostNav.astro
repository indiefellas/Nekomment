---
import type { Host } from "../../../../api/db/schema";

const { host }: { host?: Host } = Astro.props;
const hostRoot = '/' + host?.host;
---

<h4>Host</h4>
<p class="host-name">{host?.host}</p>
<nav>
    <a href={hostRoot}>Comments</a>
    <a href={hostRoot + '/pages'}>Pages</a>
    <a href={hostRoot + '/automod'}>Auto Moderation</a>
    <a href={hostRoot + '/settings'}>Host Settings</a>
</nav>

<style scoped>
    h4 {
        text-transform: uppercase;
        font-size: 0.75em;
    }

    nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--color-1);
        margin-bottom: 30px;

        a {
            font-size: 1.10em;
            text-decoration: none;
        }
    }

    @media screen and (width <= 640px) {
        .host-name {
            font-size: 1.4em;
        }

        nav {
            gap: 0;
            width: 100%;
        }
    }
</style>