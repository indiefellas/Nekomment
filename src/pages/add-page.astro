---
import AddPageForm from "../components/forms/AddPageForm.svelte";
import MainLayout from "../layouts/MainLayout.astro";
import { Database } from "../lib/databaseInterface";
export const prerender = false;
const { env } = Astro.locals.runtime;

if (!Astro.cookies.get("token")?.value) return Astro.redirect('/login?redirect=/add-host');

const db = new Database(env);
const hosts = await db.getHosts(Astro.cookies.get("token")?.value ?? '');

let args = {
    step: 0,
    domain: "",
    theme: "",
    name: "",
    err: null,
}

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const displayName = args.name = data.get("name")?.toString() || "";
        const domain = args.domain = data.get("domain")?.toString() || "";
        const theme = args.theme = data.get("theme")?.toString() || "";
        const name = crypto.randomUUID();
        let session = await db.createPage(
            Astro.cookies.get("token")?.value || "",
            displayName,
            name,
            domain,
            theme,
        );
        if (session.success) {
            return Astro.redirect("/host/" + domain + "/page/" + name, 302);
        } else {
            args.step = 2;
            args.err = session.message ?? "An error occurred. Please try again. ";
            Astro.response.status = session.status ?? 400;
        }

    } catch (e) {
        console.error(e);
        args.step = 2;
        args.err = "An error occurred. Please try again.";
        Astro.response.status = 400;
    }
}
---

<MainLayout>
    <AddPageForm hosts={hosts.data} {...args} client:load />
</MainLayout>
