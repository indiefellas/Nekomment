---
import AddPageForm from "../components/forms/AddPageForm.svelte";
import MainLayout from "../layouts/MainLayout.astro";
import { Database } from "../lib/databaseInterface";
export const prerender = false;
const { env } = Astro.locals.runtime;

if (!Astro.cookies.get("token")?.value) return Astro.redirect('/login?redirect=/add-host');

const db = new Database(env);
const hosts = await db.getHosts(Astro.cookies.get("token")?.value ?? '');

let err = "";

let args = {}

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const name = data.get("name")?.toString() || "";
        const domain = data.get("domain")?.toString() || "";
        const theme = data.get("theme")?.toString() || "";
        let session = await db.createPage(
            Astro.cookies.get("token")?.value || "",
            name,
            domain,
            theme,
        );
        if (session.success) {
            return Astro.redirect("/host/" + domain + "/pages/" + name, 302);
        } else {
            err = "An error occurred. Please try again. " + session.message;
        }

        args = {
            step: 2,
            domain,
            theme,
            name,
            err,
        }
    } catch {
        err = "An error occurred. Please try again.";
    }
}
---

<MainLayout>
    <AddPageForm hosts={hosts.data} {...args} client:load />
</MainLayout>
