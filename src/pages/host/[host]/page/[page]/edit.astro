---
import HostNav from "../../../../../components/dashboard/HostNav.astro";
import MainLayout from "../../../../../layouts/MainLayout.astro";
import { Database } from "../../../../../lib/databaseInterface";
import CodeEditor from "../../../../../components/code/CodeEditor.svelte";
import jsb from "js-beautify"
import { convertToTags, convertToTemplate } from "../../../../../lib/generators";
const { html } = jsb;

const { env } = Astro.locals.runtime;
const { host, page } = Astro.params;
const db = new Database(env);

if (!Astro.cookies.get("token")?.value)
    return Astro.redirect(`/login?redirect=${Astro.url.pathname}`);

const hostData = await db.getHost(
    Astro.cookies.get("token")?.value ?? "",
    host ?? "",
);

if (!hostData.success) return Astro.rewrite("/" + hostData.status || 0);

const pageData = await db.getPageConfig(
    Astro.cookies.get("token")?.value ?? "",
    page ?? "",
    host ?? ""
)

if (!pageData.success) return Astro.rewrite("/" + hostData.status || 0);
---

<MainLayout title={host + " - Nekomment"}>
    <div class="fill-screen">
        <div class="editor">
            <div class="left">
                <div class="bar">
                    <p>Editing Page '{pageData.data!.displayName}'</p>
                    <div class="controls">
                        <button>Save</button>
                    </div>
                </div>
                <CodeEditor client:load code={convertToTemplate(html(convertToTags(pageData.data?.template ?? ''), {
                    templating: ['handlebars']
                }))} />
            </div>
            <div class="right">
                <iframe src={'/c/' + pageData.data?.name} />
            </div>
        </div>
    </div>

    <style scoped>
        .fill-screen {
            margin: 12px;
            display: flex;
        }

        .editor {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            width: 100%;

            &>* {
                border-radius: 7px;
                overflow: hidden;
                width: 100%;
            }
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .bar {
            display: flex;
            justify-content: space-between;
            align-items: end;
            padding: 6px;
            background-color: var(--background-1);

            &>p {
                text-transform: uppercase;
                color: var(--color-1);
                font-size: 0.8em;
            }
        }

        @media screen and (width <= 800px) {
            .editor {
                grid-template-columns: 1fr;
            }
        }
    </style>
</MainLayout>