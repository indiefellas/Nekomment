---
import { Database } from "../../lib/databaseInterface";
import HostLayout from "../../layouts/HostLayout.astro";
import CommentCard from "../../components/dashboard/CommentCard.svelte";

const { env } = Astro.locals.runtime;
const { host } = Astro.params;
const db = new Database(env);

if (!Astro.cookies.get("token")?.value)
    return new Response("404 Not Found", { status: 404 });

const hostData = await db.getHost(
    Astro.cookies.get("token")?.value ?? "",
    host ?? "",
);

if (!hostData.success) return new Response("404 Not Found", { status: 404 });

const comments = await db.getComments(
    Astro.cookies.get("token")?.value ?? "",
    host ?? "",
);
---

<HostLayout title={host + " - Nekomment"} {hostData}>
    <div class="heading">
        <h1>Comments</h1>
        <a href={Astro.url.pathname + "/import"} class="button primary">Import comments</a>
    </div>
    <div class="comments-container">
        <div class="comments-list">
            <CommentCard client:load comments={comments.data?.sort((a, b) => b.createdAt - a.createdAt)} />
            {comments.data?.length === 0 && <Fragment>
                <p>No comments yet!</p>
                <p>You might want to <a href={Astro.url.pathname + "/import"}>import from your old comment service</a>?</p>
            </Fragment>}
        </div>
    </div>
</HostLayout>

<style scoped>
    .comments-container {
        margin-top: 12px;

        .heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            width: 100%;
            margin-bottom: 10px;
        }

        .actions {
            margin-top: 10px;
            display: flex;
            justify-content: end;
            gap: 5px;
        }

        .comments-list {
            margin-top: 12px;
            display: grid;
            gap: 12px;

            .comment {
                text-decoration: none;
                padding: 10px;
                flex-direction: column;
                gap: 0;

                .heading {
                    align-items: start;
                }

                blockquote {
                    flex-direction: column;
                    margin-left: 24px;
                }

                .review-container {
                    display: flex;
                    align-items: end;
                    height: 100%;
                    margin-top: 10px;
                }

                .in-review {
                    background: var(--background-red);
                    color: var(--color-red);
                    padding-inline: 0.4ch;
                    border-radius: 5px;
                    width: fit-content;
                }
            }
        }
    }
</style>
