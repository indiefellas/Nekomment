---
import MainLayout from "../layouts/MainLayout.astro";
import LoginForm from "../components/forms/LoginForm.svelte";
import CommentBg from "../components/about/CommentBg.astro";
import { Database } from "../lib/databaseInterface";

export const prerender = false; 
const { env } = Astro.locals.runtime;
const db = new Database(env);

if (Astro.cookies.get("token")?.value) return Astro.redirect('/');

let err: string = "";

if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();
        const username = data.get('username')?.toString() || '';
        const email = data.get('email')?.toString() || '';
        const password = data.get('password')?.toString() || '';
        await db.createUser(username, password, email);
        let session = await db.loginUser(username, password, Astro.request.headers.get('User-Agent') ?? '', Astro.clientAddress);
        console.log('a')
        if (session.success && session.data) {
            console.log('a')
            Astro.cookies.set('token', session.data.token, {
                httpOnly: true,
                sameSite: 'lax'
            });
            console.log('b')
            return Astro.redirect(Astro.url.searchParams.get('redirect') || '/', 302);
        }
    } catch (e) {
        err = 'An error occurred. Please try logging in again.'
    }
}
---

<MainLayout>
    <CommentBg noGradient={true} />
    <LoginForm {err} isRegister client:load />
</MainLayout>